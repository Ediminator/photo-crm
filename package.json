{
  "name": "photo-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:sast": "eslint .",
    "scan:deps": "pnpm audit --audit-level high",
    "scan:licenses": "node scripts/check-licenses.mjs",
    "test:e2e": "playwright test",
    "services:up": "docker compose -f compose.dev.yml up -d",
    "services:down": "docker compose -f compose.dev.yml down",
    "services:reset": "node scripts/services-reset.mjs",
    "services:logs": "docker compose -f compose.dev.yml logs -f",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
